{
"$schema": "https://opencode.ai/config.json",
"instructions": ["AGENTS.md"],
"lsp": true,
"mcp": {
  "context7": {
    "type": "remote",
    "url": "https://mcp.context7.com/mcp"
  }
},
"permission": {
  "bash": {
    "*": "ask",
      "git status": "ask",
      "git status *": "ask",
      "git diff": "ask",
      "git diff *": "ask",
      "git log": "ask",
      "git log *": "ask",
      "git show": "ask",
      "git show *": "ask",
      "git branch --show-current": "ask",
      "git add *": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "git pull *": "deny",
      "git fetch *": "deny",
      "git merge *": "deny",
      "git rebase *": "deny",
      "git reset *": "deny",
      "git checkout *": "deny",
      "git switch *": "deny",
      "git restore *": "deny",
      "git branch *": "deny",
      "git tag *": "deny",
      "git remote *": "deny",
      "git clone *": "deny",
      "git clean *": "deny",
      "gh *": "deny"
    }
  }
}
